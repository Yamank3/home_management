{
  "name": "home-management-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:local": "vite build --mode android-local && cap sync android && node scripts/patch-android-local.mjs",
    "test": "node --test src/offline/offline.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
